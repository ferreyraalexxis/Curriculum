---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contacto">

    <header slot="header">
        <h1>Contacto</h1>
    </header>

    <main>

        <h2 class="centrado subrayado">
            Contacto
        </h2>

        <div class="contactos">

            <!-- WhatsApp -->
            <div class="contacto whatsapp centrado">
                <a
                    href="https://wa.me/5493576418522"
                    target="_blank"
                    class="boton-contacto"
                >
                    WhatsApp
                </a>

                <p class="negrita">
                    +54 9 3576 41-8522
                </p>
            </div>


            <!-- Gmail -->
            <div class="contacto gmail centrado">
                <a
                    href="https://mail.google.com/mail/?view=cm&to=ferreyraalexxis@gmail.com"
                    target="_blank"
                    class="boton-contacto"
                >
                    Gmail
                </a>

                <p class="negrita">
                    ferreyraalexxis@gmail.com
                </p>
            </div>


            <!-- LinkedIn -->
            <div class="contacto linkedin centrado">
                <a
                    href="https://www.linkedin.com/in/alexis-ferreyra-b04074320/"
                    target="_blank"
                    class="boton-contacto"
                >
                    LinkedIn
                </a>

                <p class="negrita">
                    Alexis Ferreyra
                </p>
            </div>

        </div>

    </main>

</Layout>