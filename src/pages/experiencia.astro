---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Experiencia">

    <!-- ENCABEZADO -->

    <header slot="header" class="hero">

        <div class="hero-contenido">

            <div>
                <h1>Experiencia</h1>
            </div>

        </div>

    </header>


    <main class="inicio">

        <!-- EXPERIENCIA LABORAL -->

        <section class="seccion">

            <h2>Experiencia laboral</h2>

            <div class="experiencia-timeline">


                <!-- EXPERIENCIA 1 -->

                <article class="experiencia-item">

                    <div class="experiencia-punto">
                    </div>

                    <div class="experiencia-contenido">

                        <span class="experiencia-fecha">
                            Experiencia laboral - Pasantia nivel secundario
                        </span>

                        <h3>
                           Municipalidad de Arroyito
                        </h3>

                        <h4>
                            Duracion: 3 meses
                        </h4>

                        <ul>
                            <li>Atención al público.</li>
                            <li>Gestión y organización de turnos mediante sistemas informaticos.</li>
                            <li> Recepción y orientación de personas.</li>
                        </ul>

                    </div>

                </article>

                <!-- EXPERIENCIA 2 -->

                <article class="experiencia-item">

                    <div class="experiencia-punto">
                    </div>

                    <div class="experiencia-contenido">

                        <span class="experiencia-fecha">
                            Experiencia laboral - Empresa familiar
                        </span>

                        <h3>
                            Mecanica Rural Ferreyra
                        </h3>

                        <h4>
                            Duracion: Frecuencia irregular
                        </h4>

                        <ul>
                            <li>
                                Manejo de herramientas de taller
                            </li>

                            <li>
                                Conocimientos de hidraulica / mecanica general
                            </li>

                            <li>
                                Mantenimiento de maquinas agricolas
                            </li>

                            <li>
                               Limpieza / mantenimiento general del lugar
                            </li>
                        </ul>

                    </div>

                </article>


                <!-- EXPERIENCIA 3 -->

                <article class="experiencia-item">

                    <div class="experiencia-punto">
                    </div>

                    <div class="experiencia-contenido">

                        <span class="experiencia-fecha">
                            Experiencia laboral-Trabajo independiente
                        </span>

                        <h3>
                            Trabajo independiente
                        </h3>
                        <h4>
                            Duracion: Frecuencia irregular
                        </h4>
                        <ul>
                            <li>Manejo de herramientas de corte</li>
                            <li>Mantenimiento y limpieza de espacios verdes</li>
                            <li>Coordinación de trabajos y cumplimiento de horarios </li>
                            <li>Atención y comunicación con clientes</li>
                        </ul>

                    </div>

                </article>


            </div>

        </section>


        <!-- PROYECTOS -->

        <section class="seccion">

            <h2>Proyectos</h2>

            <div class="proyectos">


                <!-- PROYECTO CV -->

                <article class="proyecto">

                    <div class="proyecto-icono">
                        🌐
                    </div>

                    <div class="proyecto-contenido">

                        <span class="proyecto-tipo">
                            Proyecto personal
                        </span>

                        <h3>
                            Página web — Curriculum Vitae
                        </h3>

                        <p>
                            Desarrollo de una página web personal para
                            presentar mi información académica,
                            profesional, conocimientos técnicos,
                            experiencias y informacion de contacto.
                        </p>

                        <div class="tecnologias">

                            <span>Astro</span>
                            <span>HTML</span>
                            <span>CSS</span>
                            <span>JavaScript</span>

                        </div>

                    </div>

                </article>


            </div>

        </section>


        <!-- CERTIFICADOS -->

        <section class="seccion">

            <h2>Certificados</h2>

            <div class="certificados">


                <article class="certificado">
                    <div>
                        <p>
                            <img
                            src="/Certificado0.png"
                            alt="Foto de Alexis Nahuel Ferreyra"
                            width="200"
                            >
                        </p>

                    </div>

                </article>

            </div>

        </section>

    </main>

</Layout>